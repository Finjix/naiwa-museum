# Set MUSEUM_DATA_SOURCE=blob in Vercel production.
MUSEUM_DATA_SOURCE=seed

# Public museum media store and private control-data/feedback store.
BLOB_MEDIA_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Single-admin authentication.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Optional local/preview origin used by upload and CSRF checks.
MUSEUM_PUBLIC_ORIGIN=http://localhost:3000
