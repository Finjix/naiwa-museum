const WORKS = [{"zh":"构成八号奶蛙","en":"Composition VIII Milk Frog","url":"https://router-files.neta.art/files/20a862e1-d8ae-4ac7-b705-01f2bb26a64a/d1ff0fbd-6c4b-4a5e-8a26-46ea51687613.jpg","era":"modern","orig":"仿 构成 VIII","artist":"Wassily Kandinsky","year":"1923","story":"康定斯基1923年的《构成 VIII》以圆、三角、网格、弧线和斜线组织出近似乐谱的视觉节奏。这一改编没有把完整角色贴在画面上，而是将奶蛙拆解为嵌入构图的眼形圆环、黄赭与乳白碎片、短口线和深色末端；画面先保持康定斯基的抽象秩序，随后才显出奶蛙。","originalImage":"assets/context/works/w01.jpg"},{"zh":"睡莲中的奶蛙","en":"Frog Among Water Lilies","url":"https://router-files.neta.art/files/db494077-952f-4da5-b8dd-7686eb7941d4/50058f95-82e4-4dcf-89c1-409a92af27b1.jpg","era":"impressionism","orig":"仿 睡莲","artist":"Claude Monet","year":"1916","originalImage":"assets/context/monet-waterlilies.jpg","story":"莫奈晚年在吉维尼的花园里挖池、引水、种睡莲，用近三十年反复描绘同一片水面。他要画的不是莲，而是光与倒影在水上的流动，以至于取消了地平线，让观者仿佛悬浮于池上。这批《睡莲》共约250幅，是他在白内障几近失明、又痛失爱妻与长子后完成的，被视为通向抽象艺术的桥梁。"},{"zh":"神奈川冲浪奶蛙","en":"The Great Wave Frog","url":"https://router-files.neta.art/files/5612bc3c-f088-4894-bdc6-6ec84056287d/faae9e15-0297-45aa-90fc-97ca152db9bf.jpg","era":"ukiyoe","orig":"仿 神奈川冲浪里","artist":"Katsushika Hokusai","year":"c. 1831","story":"葛饰北斋的《神奈川冲浪里》约作于1831年，是《富岳三十六景》系列的一幅木版画。巨浪以\"普鲁士蓝\"这种当时新进口的颜料印成，浪爪如利齿般扑向船只，而远处的富士山静默渺小。这幅画随浮世绘流入欧洲，深深影响了梵高、莫奈与德彪西，成为\"日本主义\"浪潮的象征。","originalImage":"assets/context/works/w03.jpg"},{"zh":"构成主义奶蛙","en":"Constructivist Frog","url":"https://router-files.neta.art/files/a9271d86-4fdf-4723-ad2a-a8955991d8f3/0fa1e94a-959f-4d8e-91ad-bd84a9c9c294.jpg","era":"modern","orig":"仿 构成主义海报","artist":"El Lissitzky","year":"c. 1920","story":"构成主义诞生于1917年革命后的俄国，李西茨基等艺术家主张艺术应服务于社会建设，用几何形、红黑对角线和无衬线字体取代传统绘画。最著名的《用红楔子攻打白军》以纯粹的抽象形状讲述内战。这场运动重塑了现代平面设计、排版与建筑的语言。","originalImage":"assets/context/works/w04.jpg"},{"zh":"三个音乐家奶蛙","en":"The Milk Frog Musicians","url":"https://public.cohub.run/s/157e937b-95da-4c17-add4-f916e37c3574/neta-studio-upload/image_01KZGVXAQDTAQF3BQ6R1DSPQCV.jpg","era":"modern","orig":"仿 三个音乐家","artist":"Pablo Picasso","year":"1921","story":"毕加索以彼此嵌套的平面色块塑造三位演奏者，让人物、乐器和空间像剪贴纸一样互相穿插。这个版本把中央丑角重新组织成奶蛙的识别锚点，同时保留原作合成立体主义的断裂肢体、菱格衣片与压缩空间。","originalImage":"assets/context/works/w05.jpg"},{"zh":"撑阳伞的奶蛙","en":"Frog with a Parasol","url":"https://router-files.neta.art/files/b0147313-53a0-423f-924a-1db5d0c19621/1b2e1bc4-75c1-4632-80f9-c8cca5c3ae57.jpg","era":"impressionism","orig":"仿 撑阳伞的女人","artist":"Claude Monet","year":"1875","story":"《撑阳伞的女人》是莫奈1875年在阿让特伊描绘妻子卡蜜儿与儿子让的户外写生。人物从低处仰视，衣裙与面纱被风掀动，草叶与云影皆是快速的笔触——这正是印象派的核心：捕捉某个转瞬即逝的光线与空气的瞬间。卡蜜儿四年后病逝，画中这抹明媚遂成追忆。","originalImage":"assets/context/works/w06.jpg"},{"zh":"呐喊的奶蛙","en":"The Frog Scream","url":"https://router-files.neta.art/files/b7c6d734-f6d7-4076-a246-adb65223d459/d97df347-d862-4b3d-b283-455439db1e10.jpg","era":"modern","orig":"仿 呐喊","artist":"Edvard Munch","year":"1893","story":"蒙克的《呐喊》作于1893年，灵感来自他某次黄昏散步时\"感到天空突然变得血红\"，一声穿透自然的尖叫向他袭来。扭曲的桥、翻涌的橙红天空与骷髅般的面孔，画的不是听见尖叫，而是那份弥漫的现代性焦虑。它是表现主义的开山之作，蒙克共画了四个版本。","originalImage":"assets/context/works/w07.jpg"},{"zh":"星月奶蛙夜","en":"The Starry Frog Night","url":"https://router-files.neta.art/files/441e3c6c-0790-4f67-af81-81ce3e5288ee/3e95ae62-0fcf-4701-990f-8680f0337980.jpg","era":"postimpressionism","orig":"仿 星月夜","artist":"Vincent van Gogh","year":"1889","story":"梵高1889年在圣雷米的圣保罗精神疗养院中，凭记忆与想象画下这片旋涡般的夜空。柏树如火焰般刺向星群，村庄安睡于山谷——现实中他的病房并无此景。画作生前几乎无人问津，如今却成为最广为人知的画之一，那些翻卷的星流甚至被后人拿来比附湍流的物理。","originalImage":"assets/context/works/w08.jpg"},{"zh":"米洛斯的奶蛙","en":"Venus de Milo Frog","url":"https://router-files.neta.art/files/dfcc7219-5912-4a4b-8692-4e1a7c285632/8cbfffda-c93c-4e34-924d-5a1f8468936b.jpg","era":"ancient","orig":"仿 米洛斯的维纳斯","artist":"Alexandros of Antioch","year":"c. 130 BCE","story":"《米洛斯的维纳斯》约作于公元前130年，1820年由一位农夫在爱琴海米洛斯岛上掘出。这尊希腊化时期的大理石像被认为是爱与美的女神阿芙洛狄忒，双臂在出土时或之后遗失，反而留下无尽想象。它现藏卢浮宫，是古典理想美的化身。","originalImage":"assets/context/works/w10.jpg"},{"zh":"哥特奶蛙圣母院","en":"Notre-Dame in Frog Gothic","url":"https://router-files.neta.art/files/8de94e33-a81f-46af-9403-df18104a50cc/7c53c1de-fee5-4174-b1f7-76c3f5208994.jpg","era":"medieval","orig":"仿 巴黎圣母院","artist":"Gothic Architecture","year":"c. 1345","story":"巴黎圣母院始建于1163年，历时近两百年方成，是哥特建筑的杰作。飞扶壁将穹顶的重量向外导引，让高墙得以镂空为巨大的玫瑰花窗，阳光透过彩色玻璃洒入中殿。2019年的大火烧毁了尖塔与木构屋顶，全球随即展开修复。","originalImage":"assets/context/works/w11.jpg"},{"zh":"圣母子与奶蛙","en":"Madonna and Frog Child","url":"https://router-files.neta.art/files/1ecba054-2183-4b7f-96a1-ae9c95090b79/772af387-8105-412b-a662-2349b4eb5b70.jpg","era":"medieval","orig":"仿 宝座圣母像","artist":"Cimabue","year":"c. 1280","story":"契马布埃约1280年的《宝座圣母像》属拜占庭向文艺复兴过渡的时代。金色背景、扁平的空间与庄严的正面姿态仍是中世纪程式，但圣母衣褶间已透出一丝对体积与柔和的追求。契马布埃据传是乔托的老师，而乔托将把绘画彻底推向写实。","originalImage":"assets/context/works/w12.jpg"},{"zh":"阿尔塔米拉的奶蛙","en":"Milk Frogs of Altamira","url":"https://router-files.neta.art/files/4ccf7852-16e9-4169-914f-2436c6e23138/2b87318a-7b74-432d-8649-fbf810c572e0.jpg","era":"prehistoric","orig":"仿 阿尔塔米拉洞窟壁画","artist":"Unknown","year":"c. 36,000 BCE","story":"西班牙阿尔塔米拉洞窟的壁画约作于公元前3.6万至1.4万年间，1879年由一位业余考古学家的小女儿在洞中抬头发现。天顶上以赭红与黑炭绘满野牛，古人巧妙利用岩石的天然鼓起来塑造牛背的体积，栩栩如生。起初学界拒不相信史前人有此技艺，斥之为伪作，直到多年后才获正名，被誉为\"史前的西斯廷\"。","originalImage":"assets/context/works/w14.jpg"},{"zh":"最后的晚餐奶蛙","en":"The Frog Supper","url":"https://router-files.neta.art/files/8c3bd824-68fd-44bc-93a3-cca3f85d2bb7/167088ba-ccfe-4cfd-b4a9-a4d320689e2e.jpg","era":"renaissance","orig":"仿 最后的晚餐","artist":"Leonardo da Vinci","year":"1495–1498","story":"达·芬奇约1495至1498年为米兰圣玛利亚感恩教堂餐厅所作的《最后的晚餐》，凝固了耶稣说出\"你们中有一人要出卖我\"的刹那，十二门徒各现惊愕、疑惑、愤怒。他大胆采用干壁画法以求细节，却使颜料很快剥落，此后数百年屡经修复。","originalImage":"assets/context/works/w15.jpg"},{"zh":"创造奶蛙","en":"The Creation of Frog","url":"https://router-files.neta.art/files/2dd3d1aa-eeb1-4bcf-88c5-7791631bb2ab/1f031e8f-e028-43e1-a890-0aa1c2cc2ed0.jpg","era":"renaissance","orig":"仿 创造亚当","artist":"Michelangelo","year":"1508–1512","story":"米开朗基罗1508至1512年独自仰卧脚手架，画满西斯廷礼拜堂的天顶。《创造亚当》中，上帝与亚当的指尖将触未触，那道缝隙里蓄满了赋予生命的张力。有解剖学者指出，上帝身后的红袍轮廓酷似人类大脑的剖面。","originalImage":"assets/context/works/w16.jpg"},{"zh":"雅典学院的核心奶蛙","en":"Frog at the School of Athens","url":"https://router-files.neta.art/files/5bb77e8c-9218-4a3c-b03a-121524a020db/1e8697ae-7f52-44b3-938e-c62186512dd6.jpg","era":"renaissance","orig":"仿 雅典学院（中央）","artist":"Raphael","year":"1509–1511","story":"拉斐尔1509至1511年为梵蒂冈签字厅所绘的《雅典学院》，把跨越数百年的古代哲人聚于一堂：中央柏拉图指天、亚里士多德指地，象征理念与现实之争。据信画中许多面孔借用了同代人——沉思的赫拉克利特便是米开朗基罗的模样。","originalImage":"assets/context/works/w17.jpg"},{"zh":"岩画手印奶蛙","en":"Milk Frog of Cueva de las Manos","url":"https://router-files.neta.art/files/28f1cb22-97f8-48a2-92dc-d69f915577cb/9322c6a5-d83f-4ef8-8d3e-d42d3029bb76.jpg","era":"prehistoric","orig":"仿 手印洞岩画","artist":"Unknown","year":"c. 7,300 BCE","story":"阿根廷巴塔哥尼亚的\"手洞\"岩画约作于公元前7300年，绵延数千年。史前人将手贴壁，口含颜料管吹喷，留下数百个镂空的手印——绝大多数是左手，因多数人用右手持管。这是人类最早的\"我曾在此\"的印记之一。","originalImage":"assets/context/works/w18.jpg"},{"zh":"塞拉山奔跑奶蛙","en":"Running Milk Frog of Sierra","url":"https://router-files.neta.art/files/22623f6e-254a-4748-ae5e-d52a19d352e8/0907b219-d92b-4e7d-8911-bb541dc825af.jpg","era":"prehistoric","orig":"仿 塞拉山岩画","artist":"Unknown","year":"c. 5,500 BCE","story":"西班牙地中海沿岸的岩画（约公元前5500年及以后）以小巧灵动的人形著称，描绘狩猎、采蜜与舞蹈。与洞窟深处的巨兽不同，它们画在开敞的岩棚上，充满叙事与群体动作，记录了从狩猎向农耕过渡的生活。","originalImage":"assets/context/works/w20.jpg"},{"zh":"石阵仪式奶蛙","en":"Ritual Milk Frog at Stonehenge","url":"https://router-files.neta.art/files/d7c1eed0-e37e-4cff-a1af-7766bc96538f/54558fe5-13cd-42e0-98cb-bcef367f2871.png","era":"prehistoric","orig":"仿 巨石阵冬至仪式","artist":"Unknown","year":"c. 2,500 BCE","story":"英格兰的巨石阵约建于公元前2500年，巨大的砂岩由数十公里外运来立起。其主轴精确对准夏至日出与冬至日落，说明它既是仪式圣所，也是观测天时的历法装置。建造者如何搬运并竖起这些数十吨的巨石，至今仍是谜。","originalImage":"assets/context/works/w21.jpg"},{"zh":"岩刻游行奶蛙","en":"Procession Milk Frog of Valcamonica","url":"https://router-files.neta.art/files/95aabdf0-0282-44bb-ba29-496fad66afd4/dc8680f1-7e98-4e43-b0a4-971664253de7.png","era":"prehistoric","orig":"仿 卡莫尼卡岩刻","artist":"Unknown","year":"c. 1,000 BCE","story":"意大利卡莫尼卡山谷的岩刻绵延约八千年，多达数十万幅，是欧洲规模最大的史前岩刻群。人们在冰川磨光的岩面上凿刻战士、耕作、房屋与仪式游行，如同一部刻在石头上的漫长编年史。","originalImage":"assets/context/works/w22.jpg"},{"zh":"雪中桥奶蛙","en":"Milk Frog on a Snow Bridge","url":"https://router-files.neta.art/files/5eb29697-e3c1-412c-bdad-cd061bdcad72/e65be311-19a7-4517-9119-73f51f9ef520.png","era":"ukiyoe","orig":"仿 广重雪中桥","artist":"Utagawa Hiroshige","year":"c. 1857","story":"广重的雪景以靛蓝、灰白和桥上微小的行旅人物制造寂静的纵深。裹在冬衣中的奶蛙沿桥而行，成为雪幕中唯一温暖的色点。","originalImage":"assets/context/works/w28.jpg"},{"zh":"相扑奶蛙","en":"Edo Sumo Milk Frogs","url":"https://public.cohub.run/s/157e937b-95da-4c17-add4-f916e37c3574/neta-studio-upload/image_01M11BKBWH100FJS0314082HPK.png","era":"ukiyoe","orig":"仿 江户相扑绘","artist":"Utagawa Kuniyoshi","year":"c. 1840","story":"江户相扑绘以粗壮姿态、动态构图和鲜明木版色彩记录力士的公众形象。两只奶蛙在土俵中央角力，服饰、动作与版画节奏保持非色情的民俗竞技气质。","originalImage":"assets/context/works/w29.jpg"},{"zh":"干草堆奶蛙","en":"Milk Frog Haystacks","url":"https://router-files.neta.art/files/bdaa075e-65aa-4414-be4b-63ffaa2d5b14/52ac175f-35f1-4c97-bcbb-4815f2c2ade9.png","era":"impressionism","orig":"仿 干草堆","artist":"Claude Monet","year":"1890–1891","story":"莫奈的《干草堆》系列在同一组乡村景物中追踪季节、天气与时刻变化。这个版本保留互补色的振动与暮光中的草垛，让一只小小的奶蛙农夫成为光色秩序中的尺度。","originalImage":"assets/context/works/w30.jpg"},{"zh":"拾穗者奶蛙","en":"Milk Frog Gleaners","url":"https://router-files.neta.art/files/4bc87e21-aac8-4cf6-9e07-92914e9d894b/2c000d1b-076c-4b80-9821-2637cc525a6b.png","era":"realism","orig":"仿 拾穗者","artist":"Jean-François Millet","year":"1857","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-gleaners.jpg"},{"zh":"梅杜萨之筏奶蛙","en":"Milk Frog Raft of the Medusa","url":"https://router-files.neta.art/files/9c018a9a-42bf-42a8-b44f-ea6db6aaf5c6/678faed6-daf6-41c1-8b11-d652952bbd4b.png","era":"romanticism","orig":"仿 梅杜萨之筏","artist":"Théodore Géricault","year":"1819","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-medusa.jpg"},{"zh":"雨天的巴黎街道奶蛙","en":"Milk Frog Paris Street; Rainy Day","url":"https://router-files.neta.art/files/d2c5a4a3-1eb6-48e0-88da-7024b831324c/14c6323c-4be5-4054-b2f9-375c01dbec98.png","era":"impressionism","orig":"仿 雨天的巴黎街道","artist":"Gustave Caillebotte","year":"1877","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-paris-rain.jpg"},{"zh":"沉睡的吉普赛人奶蛙","en":"The Sleeping Milk Frog","url":"https://router-files.neta.art/files/93c7e76a-b709-45a6-accc-ec47e55d0e9b/5f9da0d4-06c8-416e-912f-5acb65f0fdd0.png","era":"modern","orig":"仿 沉睡的吉普赛人","artist":"Henri Rousseau","year":"1897","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。"},{"zh":"奥菲莉亚奶蛙","en":"Ophelia Milk Frog","url":"https://router-files.neta.art/files/0d891dd3-9455-4f35-b250-ce142e223e8f/80e8c443-002b-47f8-a048-22fcf06e8350.png","era":"pre-raphaelite","orig":"仿 奥菲莉亚","artist":"John Everett Millais","year":"1851–1852","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-ophelia.jpg"},{"zh":"1808年5月3日奶蛙","en":"The Third of May Milk Frog","url":"https://router-files.neta.art/files/590e4c58-560f-4454-b36c-9997f2ab1ade/ed0856cd-f09c-45f8-8cac-e6c1fd070216.png","era":"romanticism","orig":"仿 1808年5月3日","artist":"Francisco Goya","year":"1814","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-may3.jpg"},{"zh":"自由引导人民奶蛙","en":"Milk Frog Leading the People","url":"https://router-files.neta.art/files/208810ca-c16b-4885-8ff9-31ec2dabfc9e/a3c063d3-8845-4788-8a1a-c66158f002a9.png","era":"romanticism","orig":"仿 自由引导人民","artist":"Eugène Delacroix","year":"1830","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-liberty.jpg"},{"zh":"浪子回头奶蛙","en":"The Return of the Milk Frog","url":"https://router-files.neta.art/files/98a0475c-52fe-4fb5-b90e-6dd0d2c599d1/57d39942-8604-4a24-a1e2-a55f042fdeaa.png","era":"baroque","orig":"仿 浪子回头","artist":"Rembrandt","year":"c. 1669","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-prodigal.jpg"},{"zh":"向日葵奶蛙","en":"Sunflower Milk Frog","url":"https://router-files.neta.art/files/6d7132e0-c7d0-443f-a28d-1e241a22c661/d8f91af4-7158-47f4-b861-f071f474be5d.png","era":"postimpressionism","orig":"仿 向日葵","artist":"Vincent van Gogh","year":"1888","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-sunflowers.jpg"},{"zh":"圣维克多山奶蛙","en":"Milk Frog and Mont Sainte-Victoire","url":"https://router-files.neta.art/files/44a6dbdf-af67-4b14-a74b-18a00aeeb217/0c5e0f75-faa7-40e3-869c-51e1f66e51f2.png","era":"postimpressionism","orig":"仿 圣维克多山","artist":"Paul Cézanne","year":"c. 1904–1906","story":"该作品为历史名作改编，保留原作的构图、人物关系、动作和画面语言。","originalImage":"assets/context/works/original-cezanne.jpg"},{"zh":"夜游者奶蛙","en":"Milk Frog Nighthawks","url":"https://router-files.neta.art/files/e8e97a28-a0fd-4fe2-88f2-73ce3674ca8d/312270ba-8a5f-44b5-963b-234dd83355c5.png","era":"modern","orig":"仿 夜游者","artist":"Edward Hopper","year":"1942","story":"爱德华·霍普《夜游者》的历史名作改编，保留深夜餐馆、弧形吧台、角窗、三位顾客和中央服务员位置。"},{"zh":"雪中猎人奶蛙","en":"Milk Frog Hunters in the Snow","url":"https://router-files.neta.art/files/4978473f-db66-483a-b13d-10804e00405a/eecacb66-1966-4783-82d3-34b9b767ba02.png","era":"renaissance","orig":"仿 雪中猎人","artist":"Pieter Bruegel the Elder","year":"1565","story":"老彼得·勃鲁盖尔《雪中猎人》的历史名作改编，保留左侧下坡猎人、猎犬、裸树、结冰河面和远山村庄。"},{"zh":"阿黛尔的肖像奶蛙","en":"Milk Frog Portrait of Adele","url":"https://router-files.neta.art/files/027d8905-384d-4ddf-9bf1-09dcf44999fd/5eb502df-ee30-4f91-85aa-497187e2560e.png","era":"modern","orig":"仿 阿黛尔·布洛赫-鲍尔肖像一号","artist":"Gustav Klimt","year":"1907–1908","story":"古斯塔夫·克里姆特《阿黛尔·布洛赫-鲍尔肖像一号》的历史名作改编，保留正面半身肖像、金色背景和马赛克几何装饰。"},{"zh":"大使们奶蛙","en":"Milk Frog Ambassadors","url":"https://router-files.neta.art/files/0094507e-c768-415d-ac73-c0a594472f2d/520a49e4-f385-48b7-8212-7774996a8b69.png","era":"renaissance","orig":"仿 大使们","artist":"Hans Holbein the Younger","year":"1533","story":"小汉斯·霍尔拜因《大使们》的历史名作改编，保留双人全身构图、绿色帷幕、科学仪器桌和前景斜置骷髅。"},{"zh":"纳芙蒂蒂头像奶蛙","en":"Nefertiti Bust Milk Frog","url":"https://router-files.neta.art/files/41aaf56d-8e89-4762-8151-d00141af79fb/97dc3435-ceaa-4acb-87a5-8c914fa088a6.jpg","era":"ancient","orig":"仿 纳芙蒂蒂头像","artist":"Thutmose","year":"c. 1345 BCE","story":"古埃及《纳芙蒂蒂头像》的历史名作改编，保留三分之四胸像、蓝绿色高冠、彩绘项圈、黑色背景和石灰岩质感。","originalImage":"assets/context/works/original-nefertiti.jpg"},{"zh":"德尔斐御者奶蛙","en":"Charioteer of Delphi Milk Frog","url":"https://router-files.neta.art/files/e44f438f-b213-4540-9246-ac803d681a7a/122576ea-6ce1-4b8b-89b0-685b91de59f5.jpg","era":"ancient","orig":"仿 德尔斐御者","artist":"Unknown","year":"c. 478 BCE","story":"古希腊《德尔斐御者》的历史名作改编，保留正面全身站姿、窄头带、垂直褶衣、缰绳和灰绿色古铜包浆。","originalImage":"assets/context/works/original-charioteer.jpg"},{"zh":"新石器彩陶纹样奶蛙","en":"Neolithic Painted Pottery Milk Frog","url":"https://router-files.neta.art/files/b3e222e7-dd16-445d-9604-74b9aebc3190/854b518d-e017-485c-a6f4-b28870548667.jpg","era":"china-pre-qin","orig":"仿 新石器彩陶纹样","artist":"Unknown","year":"新石器时代","story":"作品以新石器时代彩陶为原型，将圆腹器形、矿物颜料和重复几何纹样组织成早期器物图像。奶蛙被压缩为器壁上的平面纹样，强调身体轮廓与集体装饰之间的关系。"},{"zh":"神人兽面纹玉琮奶蛙","en":"Liangzhu Jade Cong Milk Frog","url":"https://router-files.neta.art/files/62af469f-4e2b-46be-af15-8e3c6a650002/55e0b5ca-3207-49b4-bee4-74bcf4332d67.png","era":"china-pre-qin","orig":"仿 神人兽面纹玉琮","artist":"Unknown","year":"约公元前3300—2300年","story":"作品以良渚文化玉琮为原型，将方圆相套的器形、层叠纹带和神人兽面浅浮雕转译为奶蛙的玉雕身份。放大的黑色瞳孔成为中心面具的视觉锚点。"},{"zh":"四羊方尊奶蛙","en":"Four-Ram Fangzun Milk Frog","url":"https://router-files.neta.art/files/5db69cf4-49a6-443e-8600-c5045de0f16a/120426e0-a5ee-462d-9924-5087513223e1.png","era":"china-pre-qin","orig":"仿 四羊方尊","artist":"Unknown","year":"约公元前13世纪","story":"作品以商代四羊方尊为原型，保留方尊的高颈、方体、圈足、饕餮纹和雷纹结构，将四个转角的羊首改铸为奶蛙首，讨论礼器威严与角色身份之间的转换。"},{"zh":"以马忤斯的晚餐奶蛙","en":"Milk Frog Supper at Emmaus","url":"https://router-files.neta.art/files/123ab25a-fdf5-46f6-93f1-e5ee4b05fa58/7c054faa-166b-40fe-9bd3-004b0af43748.png","era":"baroque","orig":"仿 以马忤斯的晚餐","artist":"Caravaggio","year":"1601","story":"卡拉瓦乔《以马忤斯的晚餐》的历史名作改编，保留中央人物、两侧门徒、白桌布、水果和戏剧性明暗对照。","originalImage":"assets/context/works/original-emmaus.jpg"},{"zh":"绘画的艺术奶蛙","en":"Milk Frog in The Art of Painting","url":"https://router-files.neta.art/f