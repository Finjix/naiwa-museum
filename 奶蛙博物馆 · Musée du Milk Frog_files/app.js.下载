      originalImageWrap.classList.toggle('visible',!!w.originalImage);
      originalImage.src=w.originalImage||'';
      originalImage.alt=w.originalImage?`${w.orig}参考图`:'';
      originalImage.onerror=()=>originalImageWrap.classList.remove('visible');
    }
