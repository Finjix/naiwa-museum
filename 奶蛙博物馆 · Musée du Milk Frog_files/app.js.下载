  lbImgEl.onload=sizeLightboxImage;
  lbImgEl.src=w.url;
  if(lbImgEl.complete)sizeLightboxImage();
  document.getElementById('lbEra').textContent=(currentLang==='en'?ERA_LABEL_EN:ERA_LABEL)[w.era]||w.era;
